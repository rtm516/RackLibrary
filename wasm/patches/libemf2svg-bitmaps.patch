@@ -8,10 +8,53 @@
 #include "emf2svg_img_utils.h"
 #include "emf2svg_private.h"
 #include "emf2svg_print.h"
+#include <math.h>
 #include <png.h>
 #include <stdio.h>
 #include <stdlib.h>
 
+// Bitmaps drawn with SRCPAINT (OR) leave black areas untouched and those drawn
+// with SRCAND (AND) leave white areas untouched. Stencils use the pair to draw
+// masked, transparent images; emulate it by making that colour transparent.
+#define E2S_ROP_SRCAND 0x008800C6u
+#define E2S_ROP_SRCPAINT 0x00EE0086u
+static int rop_transparent_key(uint32_t rop) {
+    if (rop == E2S_ROP_SRCPAINT)
+        return 1;
+    if (rop == E2S_ROP_SRCAND)
+        return 2;
+    return 0;
+}
+
+// Fraction of the bitmap rectangle covered by the current clip's bounding box.
+static double clip_coverage(drawingStates *states, POINT_D position, POINT_D size) {
+    PATH *path = states->currentDeviceContext.clipRGN;
+    if (!states->currentDeviceContext.clipID || path == NULL)
+        return 1.0;
+    double x0 = 1e300, y0 = 1e300, x1 = -1e300, y1 = -1e300;
+    for (PATH *seg = path; seg != NULL; seg = seg->next) {
+        int n = seg->section.type == SEG_BEZIER ? 3 : (seg->section.type == SEG_MOVE || seg->section.type == SEG_LINE) ? 1 : 0;
+        POINT_D *pts = seg->section.points;
+        if (seg->section.type == SEG_ARC) {
+            pts = seg->section.points + 1; // [0] holds the radii
+            n = 1;
+        }
+        for (int i = 0; i < n; i++) {
+            x0 = fmin(x0, pts[i].x);
+            y0 = fmin(y0, pts[i].y);
+            x1 = fmax(x1, pts[i].x);
+            y1 = fmax(y1, pts[i].y);
+        }
+    }
+    double bx0 = fmin(position.x, position.x + size.x), bx1 = fmax(position.x, position.x + size.x);
+    double by0 = fmin(position.y, position.y + size.y), by1 = fmax(position.y, position.y + size.y);
+    double area = (bx1 - bx0) * (by1 - by0);
+    if (area <= 0 || x1 < x0)
+        return 1.0;
+    double w = fmin(x1, bx1) - fmax(x0, bx0), h = fmin(y1, by1) - fmax(y0, by0);
+    return (w > 0 && h > 0) ? (w * h) / area : 0.0;
+}
