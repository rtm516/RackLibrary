+// Coordinate mapping state, which SaveDC/RestoreDC must also preserve
+typedef struct {
+    double viewPortOrgX;
+    double viewPortOrgY;
+    double viewPortExX;
+    double viewPortExY;
+    bool viewPortExSet;
+    double windowOrgX;
