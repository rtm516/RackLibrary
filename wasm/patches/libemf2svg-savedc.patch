 // Stack of EMF Device Contexts
 typedef struct dc_stack {
     EMF_DEVICE_CONTEXT DeviceContext;
+    EMF_MAPPING Mapping;
     struct dc_stack *previous;
 } EMF_DEVICE_CONTEXT_STACK;
 
